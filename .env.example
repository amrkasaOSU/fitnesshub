# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/fitnesshub
POSTGRES_USER=fitnesshub
POSTGRES_PASSWORD=fitnesshub_dev_password

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Backend / Session ---
SERVER_PORT=8080
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Lax
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true
SEED_ENABLED=true

# --- AI assistant (any OpenAI-compatible chat completions API) ---
# Leave the key blank in development; the AI assistant then responds with a
# clear "not configured" message instead of failing.
#
# Free option (no credit card): Groq. Create a key at
# https://console.groq.com/keys and use:
#   OPENAI_API_KEY=gsk_...
#   OPENAI_MODEL=openai/gpt-oss-120b
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COACH_PRO_PRICE_ID=
STRIPE_CLIENT_PREMIUM_PRICE_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
