# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/fitnesshub
POSTGRES_USER=fitnesshub
POSTGRES_PASSWORD=fitnesshub_dev_password

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Backend / Session ---
SERVER_PORT=8080
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=Lax
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true
SEED_ENABLED=true

# --- AI (OpenAI) ---
# Leave blank in development; the AI assistant will respond with a
# clear "not configured" message instead of failing when this is empty.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COACH_PRO_PRICE_ID=
STRIPE_CLIENT_PREMIUM_PRICE_ID=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
