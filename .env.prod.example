# Copy to .env on the server: cp .env.prod.example .env
# docker compose reads .env automatically. Never commit the real one.

# Your domain, without https://. Must already point at this server's public IP
# or Caddy cannot obtain a certificate.
SITE_ADDRESS=fitness.example.com

# Database credentials. Generate the password, don't invent one:
#   openssl rand -base64 32
POSTGRES_USER=fitnesshub
POSTGRES_PASSWORD=replace-me-with-a-generated-secret

# Optional. Leave blank and those features report themselves as not configured
# via /api/features; the rest of the app is unaffected.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
